// Sunny 文檔網站產生器 — 自舉！
// 用 Sunny 語言讀取 Markdown 頁面，渲染成完整的 HTML 文檔。

lit layout = read_file("site/layouts/base.html")
lit home = read_file("site/layouts/home.html")
lit pages = ["index", "tutorial", "syntax", "types", "builtins", "shadow", "server", "internals", "playground"]

// 每頁的導覽標籤、標題與 meta description
lit meta = {
    "index": {"nav": "首頁", "title": "Sunny Lang — 透明的程式語言", "desc": "Sunny 是用 Rust 打造的全端程式語言：不可變優先、沒有 null、沒有 exception，並可在瀏覽器以 WebAssembly 直接試玩。"},
    "tutorial": {"nav": "教學", "title": "教學", "desc": "10 分鐘學會 Sunny：變數、函數、閉包、迴圈與 Shadow 錯誤處理。"},
    "syntax": {"nav": "語法參考", "title": "語法參考", "desc": "Sunny 完整語法規則：運算子、控制流程、match、range 與 import。"},
    "types": {"nav": "型別系統", "title": "型別系統", "desc": "Sunny 的基本型別、聯合型別與型別標註。"},
    "builtins": {"nav": "內建函數", "title": "內建函數", "desc": "Sunny 的內建函數與 List、Map、String 方法一覽。"},
    "shadow": {"nav": "Shadow 錯誤處理", "title": "Shadow 錯誤處理", "desc": "Shadow 取代 null 與 exception：用型別強制你面對錯誤。"},
    "server": {"nav": "HTTP Server", "title": "HTTP Server", "desc": "用 Resource Action 命名自動產生路由，一行指令啟動 HTTP Server。"},
    "internals": {"nav": "實作原理", "title": "實作原理", "desc": "Sunny 的內部架構：Lexer、Pratt Parser、求值器、Shadow、自舉與 WebAssembly。"},
    "playground": {"nav": "Playground 說明", "title": "Playground", "desc": "在瀏覽器中以 WebAssembly 執行 Sunny 程式碼，不需要後端。"}
}

for i in 0..len(pages) {
    lit name = pages[i]
    lit md = read_file("site/pages/" + name + ".md")
    lit body = render_md(md)

    // 側欄 / 手機選單的導覽列（含目前頁面標記）
    glow nav = ""
    for p in pages {
        glow cls = ""
        if p == name {
            cls = ' class="active" aria-current="page"'
        }
        nav = nav + '<a href="' + p + '.html"' + cls + '>' + meta[p]["nav"] + '</a>\n'
    }

    // 上一頁 / 下一頁
    glow pager = ""
    if i > 0 {
        lit prev = pages[i - 1]
        pager = pager + '<a class="prev" href="' + prev + '.html"><small>上一頁</small>' + meta[prev]["nav"] + '</a>'
    }
    if i < len(pages) - 1 {
        lit next = pages[i + 1]
        pager = pager + '<a class="next" href="' + next + '.html"><small>下一頁</small>' + meta[next]["nav"] + '</a>'
    }

    glow hero = ""
    if name == "index" {
        hero = home
    }

    lit page = render_template(layout, {
        "title": meta[name]["title"],
        "description": meta[name]["desc"],
        "slug": name,
        "nav": nav,
        "pager": pager,
        "hero": hero,
        "content": body
    })
    write_file("dist/" + name + ".html", page)
    print("Built: dist/" + name + ".html")
}

print("Done! Built " + to_string(len(pages)) + " pages.")
